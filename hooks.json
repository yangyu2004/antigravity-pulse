{
  "ag-pulse-lifecycle-monitor": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/lifecycle-hook.js SessionStart",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/lifecycle-hook.js PreInvocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/lifecycle-hook.js PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/lifecycle-hook.js PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/lifecycle-hook.js PostInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/lifecycle-hook.js Stop",
        "timeout": 5
      }
    ]
  }
}
